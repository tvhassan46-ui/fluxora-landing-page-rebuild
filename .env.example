# Local development only. Never commit real API keys.

# ElevenLabs Text-to-Speech API (Recommended):
ELEVENLABS_API_KEY=
# Optional custom voice IDs:
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_ARABIC_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_ENGLISH_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Or Google Cloud Text-to-Speech API key:
TTS_API_KEY=
GOOGLE_TTS_API_KEY=

# Vercel AI Gateway (Optional, server-side fallback translation is active automatically):
AI_GATEWAY_API_KEY=
