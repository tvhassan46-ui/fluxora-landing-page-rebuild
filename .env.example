# Local development only. Never commit real API keys.

# PostgreSQL connection used by Better Auth and Drizzle.
DATABASE_URL=postgresql://user:password@localhost:5432/liva

# Generate a unique secret with at least 32 characters.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional canonical app origin, for example https://your-domain.com.
# BETTER_AUTH_URL=http://localhost:3000

# ElevenLabs Text-to-Speech API (Recommended):
ELEVENLABS_API_KEY=
# Optional model override:
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Or Google Cloud Text-to-Speech API key:
GOOGLE_TTS_API_KEY=
# TTS_API_KEY is also accepted as a provider-key alias.
# TTS_API_KEY=
